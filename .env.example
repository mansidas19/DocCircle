# Server-side only. Never exposed to the browser.
# Leave empty to run in demo mode with deterministic mock moderation.
FABLE_API_KEY=

# Optional: override the moderation model. Defaults to claude-fable-5-1.
# If the key cannot access that model, the route falls back to claude-opus-5 automatically.
# FABLE_MODEL=claude-fable-5-1
